# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (points to the postgres container on same EC2) ───────────────────
# DB_* vars are used by docker-compose.dev.yml to init the postgres container
DB_NAME=florence_dev
DB_USER=florence
DB_PASSWORD=your_strong_password_here

# Prisma reads this. Host = postgres (docker compose service name)
DATABASE_URL=postgresql://florence:your_strong_password_here@postgres:5432/florence_dev

# ── Redis (points to the redis container on same EC2) ─────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_ACCESS_KEY=your_jwt_secret_here
JWT_SECRET_REFRESH_KEY=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Docker Hub (used by docker-compose image tag substitution) ────────────────
DOCKERHUB_USERNAME=your_dockerhub_username
