extends ./_base.pug

block body
  p Hi #{firstName},
  p We received a request to reset your #{appName} password.
  p Use the button below to continue. This reset link expires in 1 hour.
  .button-wrap
    a.button(href=resetUrl) Reset Password
  .panel
    p If the button does not open, copy and paste this link into your browser:
    p
      a(href=resetUrl) #{resetUrl}
  p If you did not request a password reset, you can ignore this email.
