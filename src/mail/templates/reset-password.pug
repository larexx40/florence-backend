doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Password Reset - TheInfluxAPP
  body
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 600px;
        margin: 20px auto;
        background: #ffffff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      }
      .header img {
        width: 100%; /* Makes the logo span the full width of the container */
        max-width: 600px; /* Ensures it doesn't exceed the container's width */
        height: auto; /* Maintains aspect ratio */
        display: block;
        margin: 0;
      }
      .content h1 {
        color: #333;
        font-size: 24px;
        text-align: center;
      }
      .content p {
        color: #555;
        font-size: 16px;
        line-height: 1.5;
      }
      .content .otp {
        font-size: 20px;
        font-weight: bold;
        color: #007BFF;
        text-align: center;
        margin: 20px 0;
      }
      .footer {
        font-size: 14px;
        text-align: center;
        color: #aaa;
        margin-top: 20px;
      }

    .container
      .header
        img(src="https://theinfluxapp-media.s3.us-east-2.amazonaws.com/assets/influx-logo.png", alt="TheInfluxAPP Logo")
      .content
        h1 Password Reset Request
        p Hi #{firstName},
        p You requested to reset your password for your TheInfluxAPP account. Use the OTP (One-Time Password) below to reset your password:
        .otp #{otp}
        p This OTP is valid for the next 10 minutes. Please enter it in the app to proceed.
        p If you didn’t request a password reset, you can safely ignore this email. Your account is secure.
        p Need help? Our support team is here for you—just reply to this email or reach out to us at 
          a(href="mailto:support@theinfluxapp.com") support@theinfluxapp.com.
      .footer
        p Best regards,
        p TheInfluxAPP Team
