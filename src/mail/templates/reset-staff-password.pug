extends ./_base.pug

block body
  p Hi #{firstName},
  p Your #{appName} account password has been reset by an administrator. Use the temporary credentials below to sign in.
  .panel
    p
      strong Email:
      |  #{email}
    p
      strong Temporary password:
      |  #{password}
  p You will be required to set a new password after logging in.
  p If you did not expect this, contact your administrator immediately.
