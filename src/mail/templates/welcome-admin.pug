doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Welcome to TheInfluxAPP - Admin Access
  body
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 600px;
        margin: 20px auto;
        background: #ffffff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      }
      .header img {
        width: 100%;
        max-width: 600px;
        height: auto;
        display: block;
        margin: 0;
      }
      .content h1 {
        color: #333;
        font-size: 24px;
        text-align: center;
      }
      .content p {
        color: #555;
        font-size: 16px;
        line-height: 1.5;
      }
      .content .credentials {
        font-size: 18px;
        font-weight: bold;
        color: #007BFF;
        text-align: center;
        margin: 20px 0;
      }
      .footer {
        font-size: 14px;
        text-align: center;
        color: #aaa;
        margin-top: 20px;
      }

    .container
      .header
        img(src="https://theinfluxapp-media.s3.us-east-2.amazonaws.com/assets/influx-logo.png", alt="TheInfluxAPP Logo")
      .content
        h1 Welcome to TheInfluxAPP - Admin Access
        p Hi #{adminName},
        p You have been granted admin access to TheInfluxAPP. Below are your login credentials:
        .credentials
          p <strong>Admin Email:</strong> #{adminEmail}
          p <strong>Temporary Password:</strong> #{adminPassword}
        p For security reasons, we strongly recommend updating your password after your first login.
        p You can access the admin dashboard here:
          a(href="https://admin.theinfluxapp.com") https://admin.theinfluxapp.com
        p If you encounter any issues or need assistance, feel free to contact our support team at
          a(href="mailto:support@theinfluxapp.com") support@theinfluxapp.com.
        p Thank you for being part of TheInfluxAPP team. We appreciate your contribution!
      .footer
        p Best regards,
        p TheInfluxAPP Team
