extends ./_base.pug

block body
  p Hi #{adminName},
  p Your staff account for #{appName} is ready. Use the temporary login details below to sign in.
  .panel
    p
      strong Email:
      |  #{adminEmail}
    p
      strong Temporary password:
      |  #{adminPassword}
    if role
      p
        strong Role:
        |  #{role}
  if adminPortalUrl
    .button-wrap
      a.button(href=adminPortalUrl) Open Admin Portal
  p For security, please change your password as soon as you log in.
  p If you were not expecting this account, contact us immediately.
